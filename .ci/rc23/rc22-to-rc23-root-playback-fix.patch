+    private suspend fun probeCatalogSource(source: PlaybackSource): PlaybackSource? = withContext(Dispatchers.IO) {
+        val url = source.uri.trim()
+        if (!ProviderSecurityPolicy.isSafeDirectMediaUrl(url)) return@withContext null
+        val startedNs = System.nanoTime()
+        fun finish(candidate: PlaybackSource?): PlaybackSource? {
+            val elapsedMs = ((System.nanoTime() - startedNs) / 1_000_000L).coerceAtLeast(0L)
+            healthRegistry.recordProbe(candidate?.uri ?: url, elapsedMs, success = candidate != null)
+            return candidate
+        }
+
+        val head = Request.Builder()
+            .url(url)
+            .header("Accept", "application/vnd.apple.mpegurl, application/dash+xml, video/*;q=0.9, */*;q=0.1")
+            .header("User-Agent", USER_AGENT)
+            .head()
+            .build()
+        val headCandidate = runCatching {
+            client.newCall(head).execute().use { response ->
+                if (!response.isSuccessful) return@use null
+                val finalUrl = response.request.url.toString()
+                if (!ProviderSecurityPolicy.isSafeDirectMediaUrl(finalUrl)) return@use null
+                val detected = detectResponseType(response.header("Content-Type"), finalUrl)
+                    ?: directUrlType(finalUrl)
+                    ?: return@use null
+                source.copy(uri = finalUrl, sourceType = detected.sourceType, mimeType = detected.mimeType, persistable = false)
+            }
+        }.getOrNull()
+        if (headCandidate != null) return@withContext finish(headCandidate)
+
+        val rangeRequest = Request.Builder()
+            .url(url)
+            .header("Accept", "application/vnd.apple.mpegurl, application/dash+xml, video/*;q=0.9, */*;q=0.1")
+            .header("Range", "bytes=0-${MAX_SNIFF_BYTES - 1}")
+            .header("Accept-Encoding", "identity")
+            .header("User-Agent", USER_AGENT)
+            .get()
+            .build()
+        val rangeCandidate = runCatching {
+            client.newCall(rangeRequest).execute().use { response ->
+                if (!response.isSuccessful) return@use null
+                val finalUrl = response.request.url.toString()
+                if (!ProviderSecurityPolicy.isSafeDirectMediaUrl(finalUrl)) return@use null
+                val prefix = response.peekBody(MAX_SNIFF_BYTES.toLong()).bytes()
+                val detected = detectResponseType(response.header("Content-Type"), finalUrl, prefix)
+                    ?: return@use null
+                source.copy(uri = finalUrl, sourceType = detected.sourceType, mimeType = detected.mimeType, persistable = false)
+            }
+        }.getOrNull()
+        finish(rangeCandidate)
+    }
