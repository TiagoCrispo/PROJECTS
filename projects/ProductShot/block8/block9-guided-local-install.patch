+@Composable
+private fun ModelInstallHelpDialog(
+    installed: Boolean,
+    onClose: () -> Unit,
+    onSelectZip: () -> Unit,
+) {
+    Dialog(onDismissRequest = onClose) {
+        Surface(shape = RoundedCornerShape(24.dp), color = Color.White) {
+            Column(
+                modifier = Modifier.padding(20.dp),
+                verticalArrangement = Arrangement.spacedBy(12.dp),
+            ) {
+                Text(
+                    text = "Motor local: guía rápida",
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.Bold,
+                    color = Color(0xFF3B2A20),
+                )
+                Text(
+                    text = "Qué necesitas seleccionar:",
+                    fontWeight = FontWeight.SemiBold,
+                    color = Color(0xFF3B2A20),
+                )
+                Text(
+                    text = "• Un archivo ZIP del modelo convertido para MediaPipe Image Generator.\n" +
+                        "• El ZIP puede traer una carpeta 'bins/' o una carpeta raíz que la contenga.\n" +
+                        "• No sirve cualquier ZIP de fotos, descargas o documentos.",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = Color(0xFF6C625C),
+                )
+                Text(
+                    text = "Qué hará ProductShot después:",
+                    fontWeight = FontWeight.SemiBold,
+                    color = Color(0xFF3B2A20),
+                )
+                Text(
+                    text = "1. Instala el ZIP en almacenamiento privado.\n" +
+                        "2. Valida que el modelo sea plausible y completo.\n" +
+                        "3. Habilita el botón 'Probar motor local'.",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = Color(0xFF6C625C),
+                )
+                if (installed) {
+                    Text(
+                        text = "Ya había una instalación previa en el teléfono. Si era incorrecta o quedó dañada, puedes eliminarla desde la tarjeta 'Motor local' y volver a instalar el ZIP correcto.",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = Color(0xFF6C625C),
+                    )
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                    OutlinedButton(onClick = onClose, modifier = Modifier.weight(1f)) {
+                        Text("Cerrar")
+                    }
+                    Button(onClick = onSelectZip, modifier = Modifier.weight(1f)) {
+                        Text("Elegir ZIP")
+                    }
+                }
+            }
+        }
+    }
